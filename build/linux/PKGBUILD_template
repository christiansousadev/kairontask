_pkgname='kairontask'
pkgname="${_pkgname}-bin"
pkgver=PACKAGE_VERSION
pkgrel=1
pkgdesc="KaironTask — Local-First Task Management & Time Tracking"
arch=('x86_64')
url="https://kairontask.app/"
license=('MIT')
depends=('gtk3' 'nss')
provides=("${_pkgname}")
conflicts=("${_pkgname}"
		   "${_pkgname}-git")
source=("kairontask-${pkgver}-amd64.deb::https://github.com/christiansousadev/kairontask/releases/download/v${pkgver}/kairontask-amd64.deb")
sha256sums=('SKIP')

package() {
	tar -xvf data.tar.xz -C "${pkgdir}"
	rm -rf "${pkgdir}/usr/share/doc"
    install -d "${pkgdir}/usr/bin"
	ln -sf "/opt/KaironTask/${_pkgname}" "${pkgdir}/usr/bin/${_pkgname}"
    install -Dm644 -t "${pkgdir}/usr/share/licenses/${pkgname}" \
    "${pkgdir}/opt/KaironTask/"{'LICENSE.electron.txt','LICENSES.chromium.html'}
}
